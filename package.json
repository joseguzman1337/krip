{
  "author": "tony_quetano@rapid7.com",
  "ava": {
    "babel": "inherit",
    "failFast": true,
    "files": [
      "test/*.js"
    ],
    "require": [
      "babel-register",
      "./test/helpers/setup-browser-env.js"
    ],
    "source": [
      "src/*.js"
    ],
    "verbose": true
  },
  "bugs": {
    "url": "https://github.com/rapid7/krip/issues"
  },
  "homepage": "https://github.com/rapid7/krip#readme",
  "dependencies": {
    "@trust/webcrypto": "^0.9.2",
    "webcrypto-shim": "^0.1.7"
  },
  "description": "Dead simple encryption in both browser and node, using WebCrypto under the hood",
  "devDependencies": {
    "ava": "^7.0.0",
    "babel-cli": "^6.26.0",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-transform-runtime": "^6.23.0",
    "babel-polyfill": "^6.26.0",
    "babel-preset-env": "^1.7.0",
    "babel-preset-minify": "^0.5.2",
    "babel-preset-stage-2": "^6.24.1",
    "babel-register": "^6.26.0",
    "babel-runtime": "^6.26.0",
    "bluebird": "^3.7.2",
    "browser-env": "^3.3.0",
    "eslint": "^10.0.3",
    "eslint-config-rapid7": "^3.1.0",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-loader": "^4.0.2",
    "fast-equals": "^6.0.0",
    "html-webpack-plugin": "^5.6.6",
    "in-publish": "^2.0.1",
    "nyc": "^18.0.0",
    "rollup": "^4.59.0",
    "rollup-plugin-babel": "^4.4.0",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-replace": "^2.2.0",
    "sinon": "^21.0.3",
    "text-encoding": "^0.7.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "main": "index.js",
  "name": "krip",
  "keywords": [
    "webcrypto",
    "crypto",
    "encrypt",
    "encryption",
    "hash"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapid7/krip.git"
  },
  "scripts": {
    "build": "NODE_ENV=production rollup -c",
    "clean:dist": "rimraf dist",
    "dev": "NODE_ENV=development webpack-dev-server  --colors --progress --profile --config=webpack/webpack.config.dev.js",
    "dist": "npm run clean:dist && npm run build",
    "lint": "eslint --max-warnings 0 src",
    "lint:fix": "npm run lint -- --fix",
    "prepublish": "if in-publish; then npm run prepublish:compile; fi",
    "prepublish:compile": "npm run lint && npm run test:coverage && npm run dist",
    "start": "npm run dev",
    "test": "NODE_PATH=. NODE_ENV=test ava",
    "test:coverage": "nyc --cache npm test",
    "test:watch": "npm run test -- --watch"
  },
  "version": "1.0.0"
}
